# ---- Datos (nunca versionar datasets masivos) ----
data/**
!data/**/
!data/**/.gitkeep

# ---- Pesos y checkpoints ----
checkpoints/**
!checkpoints/**/
!checkpoints/**/.gitkeep
*.pt
*.pth
*.ckpt

# ---- Reportes generados ----
# Se versiona la evidencia del informe (figuras, tablas y el reporte de
# profiling), porque es parte de la entrega y pesa poco. Lo demas, no.
reports/**
!reports/**/
!reports/**/.gitkeep
!reports/figures/*.png
!reports/tables/*.csv
!reports/profiling/*.html

# ---- Archivos de datos sueltos ----
*.csv
*.parquet
*.feather
*.zip
*.gz
*.7z

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---- SO / editores ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
