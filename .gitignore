# ---- Datos (nunca versionar datasets masivos) ----
data/**
!data/**/
!data/**/.gitkeep

# ---- Pesos y checkpoints ----
checkpoints/**
!checkpoints/**/
!checkpoints/**/.gitkeep
*.pt
*.pth
*.ckpt
# Excepcion: los pesos finales del ensamble (1,1 MB en total). Sin ellos el
# notebook 03 no es reproducible por quien clone el repositorio, porque los
# checkpoints viven en el Drive del autor. Cualquier otro .pt queda fuera.
# Van despues de *.pt a proposito: en .gitignore gana la ultima regla que
# coincide.
!checkpoints/modelo_base_?.pt
!checkpoints/meta_stacking.pt

# ---- Archivos de datos sueltos ----
*.csv
*.parquet
*.feather
*.zip
*.gz
*.7z

# ---- Auxiliares de LaTeX (el .tex y el .pdf si se versionan) ----
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
docs/informe/*.log

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---- SO / editores ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
